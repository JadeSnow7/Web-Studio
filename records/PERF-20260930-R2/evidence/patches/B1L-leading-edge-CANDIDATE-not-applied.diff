+      backend.onFrame = { [self] f in let t = clock_gettime_nsec_np(CLOCK_UPTIME_RAW); lock.lock(); frames.append((t, String(decoding: f.visibleData, as: UTF8.self))); lock.unlock(); prevFrame?(f) }
