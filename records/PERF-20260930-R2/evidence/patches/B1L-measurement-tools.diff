+// Measurement fixture for terminal-vt-echo-latency.swift. Modes: echo | sgr | idle.
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <termios.h>
+#include <unistd.h>
+
+static void raw_mode(void) {
+  struct termios t;
+  if (tcgetattr(STDIN_FILENO, &t) == 0) { cfmakeraw(&t); tcsetattr(STDIN_FILENO, TCSANOW, &t); }
+}
+
+int main(int argc, char **argv) {
+  const char *mode = argc > 1 ? argv[1] : "echo";
+  raw_mode();
+  if (strcmp(mode, "sgr") == 0) {
+    // Mixed-SGR flood: deterministic pseudo-random 256-colour / bold / underline / reset runs, 80-col lines.
+    enum { CAP = 1 << 16 };
+    static char buf[CAP];
+    size_t used = 0; unsigned s = 12345;
+    while (used < CAP - 400) {
+      for (int col = 0; col < 76;) {
+        s = s * 1103515245u + 12345u;
+        int style = (s >> 16) % 5, run = 3 + (int)((s >> 8) % 9);
+        if (col + run > 76) run = 76 - col;
+        if (style == 0) used += (size_t)snprintf(buf + used, 64, "\033[0m");
+        else if (style == 1) used += (size_t)snprintf(buf + used, 64, "\033[1;38;5;%um", (s >> 4) % 256);
+        else if (style == 2) used += (size_t)snprintf(buf + used, 64, "\033[4;48;5;%u;38;5;%um", (s >> 3) % 256, (s >> 11) % 256);
+        else if (style == 3) used += (size_t)snprintf(buf + used, 64, "\033[38;2;%u;%u;%um", (s >> 2) & 255, (s >> 10) & 255, (s >> 18) & 255);
+        else used += (size_t)snprintf(buf + used, 64, "\033[7m");
+        for (int i = 0; i < run; i++) buf[used++] = (char)('a' + (s >> (i % 16)) % 26);
+        col += run;
+      }
+      used += (size_t)snprintf(buf + used, 16, "\033[0m\r\n");
+    }
+    for (;;) { size_t off = 0; while (off < used) { ssize_t n = write(STDOUT_FILENO, buf + off, used - off); if (n <= 0) return 1; off += (size_t)n; } }
+  }
+  write(STDOUT_FILENO, "READY", 5);
+  if (strcmp(mode, "idle") == 0) { char c; while (read(STDIN_FILENO, &c, 1) > 0) {} return 0; }
+  // echo: every received byte n clears the screen and prints "E<n>;" in one write.
+  unsigned n = 0; char c, out[64];
+  while (read(STDIN_FILENO, &c, 1) == 1) {
+    n++;
+    int len = snprintf(out, sizeof out, "\033[H\033[2JE%u;", n);
+    write(STDOUT_FILENO, out, (size_t)len);
+  }
+  return 0;
+}
