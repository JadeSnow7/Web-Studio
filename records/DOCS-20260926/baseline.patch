+      guard model.panels.panel == .commands, !textView.hasMarkedText() else { return false }
+      switch commandSelector {
+      case #selector(NSResponder.moveUp(_:)):
+        model.commandSelectedIndex = max(0, model.commandSelectedIndex - 1)
