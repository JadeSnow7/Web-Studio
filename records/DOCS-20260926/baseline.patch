+  func selectTab(at index: Int) {
+    let tabs = visibleTabs
+    guard !tabs.isEmpty else { return }
+    let target = index >= 8 ? tabs.count - 1 : index
+    guard tabs.indices.contains(target) else { return }
+    selectedTabID = tabs[target].id
