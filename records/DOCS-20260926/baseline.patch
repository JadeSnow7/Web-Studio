+  private func cycleTab(by offset: Int) {
+    let tabs = visibleTabs
+    guard tabs.count > 1,
+      let current = tabs.firstIndex(where: { $0.id == selectedTabID })
+    else { return }
+    selectedTabID = tabs[(current + offset + tabs.count) % tabs.count].id
+  }
