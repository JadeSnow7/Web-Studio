+    if let record = webRuntimes.records[id] { selectedGroupID = record.groupID }
+    let isBlankWeb =
+      webRuntimes.records[id].map { record in
+        if case .web(nil) = record.location { return true }
+        return false
+      } ?? false
+    if !isBlankWeb {
