+        let f = resolveResidentFont(slot)
+        let key = GlyphKey(font: lookup.fontIDs[slot], scale: scaleBits, text: cell.text)
+        if seen.insert(key).inserted { requests.append((key, cell.text, f, scale)) }
+      }
+      return requests
